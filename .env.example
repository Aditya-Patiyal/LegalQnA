# Supabase project settings → Settings → API → "Publishable and secret API keys"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# The "secret key" (sb_secret_...) on that same page. NEVER put this in the frontend or a
# Render "sync" env var visible to anyone but you — only scripts/index_law_kb.py
# uses it, run locally/once, not part of the deployed service's request path.
SUPABASE_SERVICE_ROLE_KEY=

# console.groq.com — free tier, no card required
GROQ_API_KEY=

# huggingface.co/settings/tokens — free tier, no card required.
# Needed for both document embeddings and the one-time law-KB indexing script.
HUGGINGFACE_API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# e.g. https://your-app.vercel.app,http://localhost:5500
CORS_ORIGINS=http://localhost:5500

MAX_UPLOAD_BYTES=10485760
